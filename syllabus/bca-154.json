    { "number": 4, "title": "Anti-derivative and its Applications", "hours": 8, "topics": ["Indefinite and definite integrals", "Area under curves"] },
    { "number": 5, "title": "Differential Equations", "hours": 8, "topics": ["First-order differential equations", "Applications"] },
